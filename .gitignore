# Local-only context for the operator's own deployment. Never commit: it names
# real hosts and addresses.
*.local.md
.env
node_modules/
dist/
.DS_Store

# Local test harnesses wired to real instances. Local only.
tools/probe/local/
.tsbuild/

# Real instance config (hosts, addresses). Copy config/instances.example.json.
config/instances.json
__pycache__/
config/learned.json
config/*.tmp

# Local Docker overrides (e.g. host networking for discovery).
docker-compose.override.yml
config/presets.json
config/roon.json

# Private terms for the PII hooks (tools/hooks). The terms themselves are private.
pii-denylist.local
COMMIT

# Browser smoke tests: screenshots and reports are build output, reviewed from CI.
e2e/screenshots/
e2e/test-results/
e2e/report/

# Claude Code agent worktrees (temporary checkouts inside the repo)
.claude/worktrees/
