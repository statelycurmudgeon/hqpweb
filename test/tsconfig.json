{
  "extends": "../tsconfig.base.json",
  // The cross-cutting tests at the root: checked on their own (npm run typecheck), not built.
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": ["*.ts"]
}
